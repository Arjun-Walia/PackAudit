FROM python:3.12-slim-bookworm
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml ./
COPY packages/contracts/py packages/contracts/py
COPY packages/db packages/db
COPY engine/lmpc engine/lmpc
COPY services/api services/api
RUN pip install --no-cache-dir ./packages/contracts/py ./packages/db ./engine/lmpc ./services/api
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "lmpc_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
